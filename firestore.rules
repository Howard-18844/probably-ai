rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE THIS to your own Google email (same one as ADMIN_EMAIL in config.js)
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'your-email@gmail.com';
    }

    // The Discord Worker signs in as this special user (see DISCORD-SETUP.md).
    // CHANGE THIS to the "User UID" of the bot user you create in Firebase.
    function isBot() {
      return request.auth != null && request.auth.uid == 'PASTE-BOT-USER-UID-HERE';
    }

    // One document per visitor chat. The chat id is a long random code,
    // so only the visitor who owns it (and you) know where it is.
    match /chats/{chatId} {
      allow get: if true;
      allow list: if isAdmin();               // only you can browse all chats
      allow create, update: if (isAdmin() || isBot() || request.resource.data.lastFrom in ['user', 'auto'])
          && request.resource.data.keys().hasOnly(['lastAt', 'lastText', 'lastFrom', 'needsReply'])
          && request.resource.data.lastText is string
          && request.resource.data.lastText.size() <= 80;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if true;
        // Visitors may only write "user" messages (and the scripted "auto" ones).
        // Only YOU can write "human" messages.
        allow create: if (isAdmin() || isBot() || request.resource.data.from in ['user', 'auto'])
            && request.resource.data.keys().hasOnly(['from', 'text', 'ts'])
            && request.resource.data.text is string
            && (request.resource.data.text.size() <= 1000 || ((isAdmin() || isBot()) && request.resource.data.text.size() <= 4000));
        allow update, delete: if isAdmin();
      }
    }

    // Auto-reply on/off and delay. Everyone can read, only you can change.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
